DATABASE_URL=postgresql+psycopg://drivebook:drivebook@db:5432/drivebook
# Vercel Marketplace Postgres integrations commonly inject POSTGRES_URL. Either
# POSTGRES_URL or DATABASE_URL is accepted; postgresql:// URLs are normalized.
POSTGRES_URL=
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PAYMENTS_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
# Use a long random value when calling /internal/reminders/run from your scheduler.
REMINDER_SECRET=replace-with-a-long-random-secret
REMINDER_HOURS_BEFORE=24
FEEDBACK_REMINDER_MINUTES_AFTER=30
BOOKING_HOLD_MINUTES=30
