NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Server-side address used by the Next.js /api proxy. In Docker Compose this is
# http://backend:8000; use the internal/private backend address when split-hosting.
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=https://rajinstructor.co.nz
# Set only for a local product demonstration. Never enable in production.
NEXT_PUBLIC_DEMO_MODE=false
